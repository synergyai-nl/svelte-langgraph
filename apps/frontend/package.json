{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure message-modules --is-server=import.meta.env.SSR --silent",
		"build": "npm run paraglide && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "npm run paraglide && vitest run",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@inlang/paraglide-js": "^2.25.4",
		"@internationalized/date": "^3.10.0",
		"@langchain/core": "^1.1.31",
		"@langchain/langgraph-sdk": "^1.8.3",
		"@lucide/svelte": "^0.562.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.4",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.0.10",
		"@vitest/coverage-v8": "^4.1.12",
		"@vitest/ui": "^4.0.18",
		"bits-ui": "^2.15.4",
		"clsx": "^2.1.1",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"jsdom": "^26.0.0",
		"oauth2-mock-server": "^9.3.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"shadcn-svelte": "1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"svelte-exmarkdown": "^5.0.1",
		"tailwind-animate": "^0.2.10",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.0.0",
		"tailwindcss-animate": "^1.0.7",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^8.0.12",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@langchain/svelte": "^0.3.1",
		"@sentry/sveltekit": "^11.14.0",
		"@svelte-langgraph/client": "workspace:*",
		"better-auth": "1.7.12",
		"mode-watcher": "^1.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/svelte-langgraph-client/index.ts": "@svelte-langgraph/client",
		"#lib/*": "./src/lib/*"
	}
}
