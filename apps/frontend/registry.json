{
	"$schema": "https://shadcn-svelte.com/schema/registry.json",
	"name": "svelte-langgraph",
	"homepage": "https://github.com/synergyai-nl/svelte-langgraph",
	"aliases": {
		"lib": "$lib",
		"ui": "$lib/components/ui",
		"utils": "$lib/utils",
		"hooks": "$lib/hooks"
	},
	"items": [
		{
			"name": "chat",
			"type": "registry:block",
			"title": "Chat",
			"description": "LangGraph chat UI: the <LangGraph> provider, Conversation, ChatSurface, ThreadList and their message components, localized with Paraglide (strings in messages/chat/{locale}.json). TODO: @svelte-langgraph/client is a private workspace package (packages/client) that is not published to npm yet.",
			"registryDependencies": [
				"button",
				"card",
				"sidebar",
				"spinner",
				"textarea",
				"tooltip",
				"https://shadcn-svelte-extras.com/r/copy-button.json"
			],
			"dependencies": [
				"@inlang/paraglide-js@^2.25.4",
				"@langchain/langgraph-sdk@^1.8.3",
				"@langchain/svelte@^0.3.1",
				"@lucide/svelte@^0.562.0",
				"@svelte-langgraph/client",
				"svelte-exmarkdown@^5.0.1"
			],
			"devDependencies": [],
			"files": [
				{
					"path": "src/lib/components/chat/AIMessageActions.svelte",
					"type": "registry:component",
					"target": "chat/AIMessageActions.svelte"
				},
				{
					"path": "src/lib/components/chat/ChatErrorMessage.svelte",
					"type": "registry:component",
					"target": "chat/ChatErrorMessage.svelte"
				},
				{
