					"target": "svelte-langgraph/MessageComposer.svelte"
				},
				{
					"path": "src/lib/components/chat/Conversation.svelte",
					"type": "registry:component",
					"target": "svelte-langgraph/Conversation.svelte"
				},
				{
					"path": "src/lib/components/chat/FeedbackButtons.svelte",
					"type": "registry:component",
					"target": "svelte-langgraph/FeedbackButtons.svelte"
				},
				{
					"path": "src/lib/components/chat/FeedbackDialog.svelte",
					"type": "registry:component",
					"target": "svelte-langgraph/FeedbackDialog.svelte"
				},
				{
