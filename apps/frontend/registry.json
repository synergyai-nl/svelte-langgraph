				},
				{
					"path": "src/lib/components/ChatLoader.svelte",
					"type": "registry:component",
					"target": "ChatLoader.svelte"
				},
				{
					"path": "messages/chat/en.json",
					"type": "registry:file",
					"target": "messages/chat/en.json"
				},
				{
					"path": "messages/chat/nl.json",
					"type": "registry:file",
					"target": "messages/chat/nl.json"
