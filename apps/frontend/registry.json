{
	"$schema": "https://shadcn-svelte.com/schema/registry.json",
	"name": "svelte-langgraph",
	"homepage": "https://github.com/synergyai-nl/svelte-langgraph",
	"aliases": {
		"lib": "$lib",
		"ui": "$lib/components/ui",
		"utils": "$lib/utils",
		"hooks": "$lib/hooks"
	},
	"items": [
		{
			"name": "chat",
			"type": "registry:block",
			"title": "Chat",
			"description": "LangGraph chat UI: the <LangGraph> provider, Conversation, ChatSurface, ThreadList and their message components, localized with Paraglide (strings in messages/chat/{locale}.json). Bundles the @svelte-langgraph/client library under $lib/svelte-langgraph-client, which needs a kit.alias entry for @svelte-langgraph/client (SvelteKit 2).",
			"registryDependencies": [
				"button",
				"card",
				"dialog",
				"input",
				"is-mobile",
				"separator",
				"sheet",
				"sidebar",
				"skeleton",
				"spinner",
				"textarea",
				"tooltip",
				"https://shadcn-svelte-extras.com/r/use-clipboard.json"
			],
			"dependencies": [
				"@inlang/paraglide-js@^2.25.4",
				"@langchain/langgraph-sdk@^1.8.3",
				"@langchain/svelte@^0.3.1",
				"@lucide/svelte@^0.562.0",
				"@tailwindcss/typography@^0.5.15",
				"bits-ui@^2.15.4",
				"svelte-exmarkdown@^5.0.1",
				"tailwind-variants@^3.2.2"
			],
			"devDependencies": [],
			"files": [
