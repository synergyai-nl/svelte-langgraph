{
	"$schema": "https://shadcn-svelte.com/schema/registry.json",
	"name": "svelte-langgraph",
	"homepage": "https://github.com/synergyai-nl/svelte-langgraph",
	"aliases": {
		"lib": "$lib",
		"ui": "$lib/components/ui",
		"utils": "$lib/utils",
		"hooks": "$lib/hooks"
	},
	"items": [
		{
			"name": "chat",
			"type": "registry:block",
			"title": "Chat",
			"description": "LangGraph chat UI: the <LangGraph> provider, Conversation, ChatSurface, ThreadList and their message components, installed into $lib/components/svelte-langgraph/ and localized with Paraglide (strings in messages/svelte-langgraph/{locale}.json). Uses your stock shadcn-svelte components and ships no copies of them. Bundles the @svelte-langgraph/client library under $lib/svelte-langgraph-client, which needs a kit.alias entry for @svelte-langgraph/client (SvelteKit 2).",
			"registryDependencies": [
				"button",
				"card",
				"dialog",
				"input",
				"is-mobile",
				"separator",
				"sheet",
				"sidebar",
				"skeleton",
				"spinner",
				"textarea",
				"tooltip",
				"https://shadcn-svelte-extras.com/r/use-clipboard.json"
			],
			"dependencies": [
				"@langchain/langgraph-sdk@^1.8.3",
				"@langchain/svelte@^0.3.1",
				"@tailwindcss/typography@^0.5.15",
				"svelte-exmarkdown@^5.0.1"
			],
			"devDependencies": [],
			"files": [
				{
					"path": "src/lib/components/chat/AIMessageActions.svelte",
					"type": "registry:component",
					"target": "svelte-langgraph/AIMessageActions.svelte"
				},
				{
					"path": "src/lib/components/chat/ChatErrorMessage.svelte",
					"type": "registry:component",
					"target": "svelte-langgraph/ChatErrorMessage.svelte"
				},
				{
					"path": "src/lib/components/chat/ChatMessage.svelte",
					"type": "registry:component",
					"target": "svelte-langgraph/ChatMessage.svelte"
				},
				{
					"path": "src/lib/components/chat/ChatSurface.svelte",
					"type": "registry:component",
					"target": "svelte-langgraph/ChatSurface.svelte"
				},
				{
					"path": "src/lib/components/chat/ChatToolMessage.svelte",
					"type": "registry:component",
					"target": "svelte-langgraph/ChatToolMessage.svelte"
				},
				{
					"path": "src/lib/components/chat/ChatWaiting.svelte",
