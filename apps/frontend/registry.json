					"type": "registry:component",
					"target": "chat/ThreadList/index.ts"
				},
				{
					"path": "src/lib/components/chat/ThreadList/ThreadList.svelte",
					"type": "registry:component",
					"target": "chat/ThreadList/ThreadList.svelte"
				},
				{
					"path": "src/lib/components/chat/ThreadList/ThreadListItem.svelte",
					"type": "registry:component",
