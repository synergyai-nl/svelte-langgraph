					"type": "registry:component",
					"target": "chat/ChatSurface.svelte"
				},
				{
					"path": "src/lib/components/chat/ChatToolMessage.svelte",
					"type": "registry:component",
					"target": "chat/ChatToolMessage.svelte"
				},
				{
					"path": "src/lib/components/chat/ChatWaiting.svelte",
					"type": "registry:component",
					"target": "chat/ChatWaiting.svelte"
				},
				{
					"path": "src/lib/components/chat/MessageComposer.svelte",
					"type": "registry:component",
					"target": "chat/MessageComposer.svelte"
				},
				{
